{
  "name": "namingo/cardo-drs",
  "description": "Cardo DRS - a unified PHP interface for working with multiple domain registrar APIs.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "domain",
    "registrar",
    "api",
    "namesilo",
    "godaddy",
    "namecheap",
    "dynadot",
    "name.com",
    "namecom",
    "opensrs"
  ],
  "homepage": "https://github.com/getnamingo/cardo-drs",
  "support": {
    "issues": "https://github.com/getnamingo/cardo-drs/issues",
    "source": "https://github.com/getnamingo/cardo-drs"
  },
  "autoload": {
    "psr-4": {
      "Namingo\\Cardo\\DRS\\": "src/",
      "Namingo\\Cardo\\DRS\\Adapters\\": "src/adapters/"
    }
  },
  "authors": [
    {
      "name": "josuamarcelc",
      "email": "me@josuamarcelc.com"
    },
    {
      "name": "Terbora Ltd",
      "email": "hello@terbora.com",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "guzzlehttp/guzzle": "^7.10",
    "ext-simplexml": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": [
      "php tests/AutoloadRegressionTest.php",
      "php tests/AdapterRegressionTest.php"
    ]
  }
}
